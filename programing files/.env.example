# LINE Bot
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# DB接続（このファイルを実行する環境のDB）
DATABASE_URL=postgresql://user:password@host:5432/dbname
# sync_db_to_prod.py 等、dev→prod同期スクリプト用（.env側にのみ必要）
DEV_DATABASE_URL=postgresql://user:password@dev-host:5432/dbname

# LIFF（会員登録・レビュー投稿・マイ時間割の各ボタン用）
REGISTER_LIFF_ID=xxxxxxxxxx-xxxxxxxx
REVIEW_LIFF_ID=xxxxxxxxxx-xxxxxxxx
TIMETABLE_LIFF_ID=xxxxxxxxxx-xxxxxxxx

# レビュー投稿フォームのベースURL（本番/devで固定値が異なる。CLAUDE.md参照）
REVIEW_FORM_URL=https://example.onrender.com

# setup_richmenu.py実行後に払い出されるリッチメニューID（登録前ユーザー用）
RICHMENU_ID_PREREGISTER=richmenu-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DBバックアップ（download_prod_backup.py用、Supabase Storage）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
BACKUP_BUCKET=db-backups
# 任意：設定するとPC故障時用にOneDrive配下へも複製する
ONEDRIVE_BACKUP_DIR=
